 "catalog": [
  {
   "KPI_ID": "KPI-01",
   "KPI_Name": "Appeal Volume",
   "Business_Definition": "Count of appeals received in the reporting period",
   "Formula": "COUNT(Appeal_ID) WHERE Received_Date BETWEEN period start AND end",
   "Authoritative_Source": "Appeals case system",
   "Unit": "Count",
   "Tolerance": "0 variance"
  },
  {
   "KPI_ID": "KPI-02",
   "KPI_Name": "Open Backlog",
   "Business_Definition": "Count of appeals not closed as of the reporting date",
   "Formula": "COUNT(Appeal_ID) WHERE Status <> 'Closed' AS OF reporting date",
   "Authoritative_Source": "Appeals case system",
   "Unit": "Count",
   "Tolerance": "0 variance"
  },
  {
   "KPI_ID": "KPI-03",
   "KPI_Name": "Median Turnaround",
   "Business_Definition": "Median calendar days from receipt to closure for closed appeals",
   "Formula": "MEDIAN(Closed_Date - Received_Date) WHERE Status = 'Closed'",
   "Authoritative_Source": "Appeals case system",
   "Unit": "Days",
   "Tolerance": "under 0.25 days"
  },
  {
   "KPI_ID": "KPI-04",
   "KPI_Name": "SLA Compliance",
   "Business_Definition": "Closed appeals meeting the SLA target divided by closed appeals",
   "Formula": "COUNT(SLA_Met = 'Yes') / COUNT(Status = 'Closed')",
   "Authoritative_Source": "Appeals case system",
   "Unit": "Percent",
   "Tolerance": "under 1 percentage point"
  },
  {
   "KPI_ID": "KPI-05",
   "KPI_Name": "First-Pass Routing Accuracy",
   "Business_Definition": "Appeals resolved without reassignment divided by all appeals",
   "Formula": "COUNT(Reassignment_Count = 0) / COUNT(Appeal_ID)",
   "Authoritative_Source": "Workflow tracker",
   "Unit": "Percent",
   "Tolerance": "under 1 percentage point"
  },
  {
   "KPI_ID": "KPI-06",
   "KPI_Name": "Rework Rate",
   "Business_Definition": "Appeals requiring rework divided by all appeals",
   "Formula": "COUNT(Rework_Flag = 'Yes') / COUNT(Appeal_ID)",
   "Authoritative_Source": "Workflow tracker",
   "Unit": "Percent",
   "Tolerance": "under 1 percentage point"
  }
 ],
