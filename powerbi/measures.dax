// DAX measures - KPI Trust Ledger
// Generated by src/build_bi_assets.py from dashboard/dashboard_config.json.
// Paste into Power BI Desktop, or open powerbi/model.bim in Tabular Editor.

// KPIs in catalogue from the headline query extract.
KPIs in catalogue =
    SELECTEDVALUE ( 'headline'[kpis] )
// format: #,0

// of 6 — the rest cannot be quoted
KPIs certified =
    SELECTEDVALUE ( 'headline'[certified] )
// format: #,0

// 13 testable KPI-source pairs
Reconciliation rate =
    SELECTEDVALUE ( 'headline'[recon_rate] )
// format: 0.00"%"

// of 13 testable
Pairs in agreement =
    SELECTEDVALUE ( 'headline'[pairs_agreed] )
// format: #,0

// Reporting layer rows from the vol query extract.
Reporting layer rows =
    SELECTEDVALUE ( 'vol'[reporting_rows] )
// format: #,0

// Same period, 58 more appeals than the certified layer
Case management rows =
    SELECTEDVALUE ( 'vol'[cm_rows] )
// format: #,0

// 1 Critical, 213 High
DQ exceptions =
    SELECTEDVALUE ( 'vol'[exceptions] )
// format: #,0

// Source does not carry the field — neither pass nor fail
Pairs not testable =
    SELECTEDVALUE ( 'headline'[not_testable] )
// format: #,0

// Sources within tolerance for the 'How many sources agree, per KPI' visual.
Sources within tolerance (cert_chart) =
    SUM ( 'cert_chart'[agreed] )
// format: #,0.00

// Sources outside tolerance for the 'How many sources agree, per KPI' visual.
Sources outside tolerance (cert_chart) =
    SUM ( 'cert_chart'[disagreed] )
// format: #,0.00

// Open appeals reported for the 'One question, four answers' visual.
Open appeals reported (backlog) =
    SUM ( 'backlog'[backlog] )
// format: #,0.00

// Within tolerance % for the 'Reconciliation rate by source' visual.
Within tolerance % (by_source) =
    AVERAGE ( 'by_source'[recon_pct] )
// format: #,0.00

// Variance from certified value for the 'Largest variances' visual.
Variance from certified value (variance) =
    SUM ( 'variance'[variance] )
// format: #,0.00

// Rows in source for the 'Row counts by source' visual.
Rows in source (row_counts) =
    SUM ( 'row_counts'[rows_present] )
// format: #,0.00

// Exceptions for the 'Exceptions by severity' visual.
Exceptions (severity) =
    SUM ( 'severity'[exceptions] )
// format: #,0.00

// Appeals received for the 'Certified reporting layer over time' visual.
Appeals received (monthly) =
    SUM ( 'monthly'[received] )
// format: #,0.00

// Still open for the 'Certified reporting layer over time' visual.
Still open (monthly) =
    SUM ( 'monthly'[still_open] )
// format: #,0.00

// SLA compliance % for the 'Certified reporting layer over time' visual.
SLA compliance % (monthly) =
    AVERAGE ( 'monthly'[sla_pct] )
// format: #,0.00
